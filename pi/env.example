# Copy to ~/interview-pi/.env on the Pi and fill in.
INTERVIEW_SERVER=https://interviewos-cpg104.vercel.app
# Same value as DEVICE_TOKEN in the Vercel project settings (keep it secret)
INTERVIEW_DEVICE_TOKEN=
# Bluetooth speaker MAC address (leave empty to use the headphone jack / USB speaker)
INTERVIEW_BT_SPEAKER=
INTERVIEW_HOTSPOT=InterviewOS
INTERVIEW_HOTSPOT_PASS=interview123
