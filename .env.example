# Copy to .env.local for local runs (or run `vercel env pull .env.local`).
OPENAI_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Dashboard login
ADMIN_USER=admin
ADMIN_PASSWORD=
# Random string used to sign the login cookie
SESSION_SECRET=
# Shared secret the Pi sends in the X-Device-Token header
DEVICE_TOKEN=
